<IfModule mod_rewrite.c>
  RewriteEngine On

  # TotalCoin sends a server-to-server POST to the historical SenForms path.
  # Rewrite both spellings internally so Apache never issues a DirectorySlash
  # redirect that could change POST to GET or discard the ApiKey header.
  RewriteRule ^notification/tcwbh/?$ totalcoin_webhook.php [END]
</IfModule>

# Evita que copias de base, logs, respaldos o configuraciones históricas
# puedan descargarse aunque accidentalmente queden dentro del document root.
<FilesMatch "(?i)(^arca_config\.json$|\.(?:sqlite|sqlite3|db|sql|log|env|ini|bak|save|pem|key|crt|p12|pfx|tar|gz|zip)$)">
  Require all denied
</FilesMatch>

# Código operativo que forma parte del repositorio pero no de la superficie web.
<IfModule mod_rewrite.c>
  RewriteRule ^(?:tests|migrations|tools|patchs)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:diag_|debug_|check_setup\.php$|apply_mapping_|import_|tmp_) - [F,L,NC]
</IfModule>
